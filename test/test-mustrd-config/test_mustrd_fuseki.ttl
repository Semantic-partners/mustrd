@prefix : <https://mustrd.org/mustrdTest/> .
@prefix triplestore: <https://mustrd.org/triplestore/> .

:fuseki_live a :MustrdTest ;
    :hasSpecPath "../test-specs/expected-success" ;
    :hasDataPath "../data" ;
    :triplestoreSpecPath "fuseki_config_example.ttl" ;
    :hasPytestPath "fuseki" ;
    :filterOnTripleStore triplestore:fuseki_local .
