# Competency questions over mustrd's OWN model.
#
# Separate from test_config_local.ttl so the main suite's coverage numbers are not
# perturbed: this config measures mustrd/model/ontology.ttl, which every other run
# treats as the vocabulary specs are written in rather than the subject.
@prefix : <https://mustrd.org/mustrdTest/> .
@prefix triplestore: <https://mustrd.org/triplestore/> .

:selfModel a :MustrdTest ;
    :hasSpecPath     "self-model/specs" ;
    :hasDataPath     "self-model/data" ;
    :hasOntologyPath "../mustrd/model/ontology.ttl" ;
    :hasPytestPath   "self_model" ;
    :filterOnTripleStore triplestore:RdfLib .
