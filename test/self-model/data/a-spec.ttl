# A mustrd spec, used here as *data*.
#
# mustrd's own vocabulary is written declaratively — a spec IS must: terms rather
# than asking about them — so nothing queries must: unless a spec reads a spec file
# as its given. That is what the specs in ../specs do, and this is what they read.
#
# Deliberately a fixture rather than a copy of a real suite spec: these tests
# assert exact results, and should not break when somebody edits an unrelated file.
# Kept named .ttl, not .mustrd.ttl, so no spec collection ever picks it up.
@prefix must: <https://mustrd.org/model/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ex:   <http://example.org/spec/> .

ex:selectFromAFile
    a          must:TestSpec ;
    must:given [ a must:FileDataset ; must:file "given.ttl" ] ;
    must:when  [ a must:TextSparqlSource ;
                 must:queryType must:SelectSparql ;
                 must:queryText "SELECT ?s WHERE { ?s ?p ?o }" ] ;
    must:then  [ a must:TableDataset ;
                 must:hasRow [ must:hasBinding [ must:variable "s" ;
                                                 must:boundValue ex:thing ] ] ] .

ex:constructFromStatements
    a          must:TestSpec ;
    must:given [ a must:StatementsDataset ;
                 must:hasStatement [ a rdf:Statement ;
                                     rdf:subject   ex:thing ;
                                     rdf:predicate ex:knows ;
                                     rdf:object    ex:other ] ] ;
    must:when  [ a must:FileSparqlSource ;
                 must:queryType must:ConstructSparql ;
                 must:file "build.rq" ] ;
    must:then  [ a must:FileDataset ; must:file "expected.ttl" ] .
