# How does a spec state its expected result? Covers the must:then side of the model.
@prefix must: <https://mustrd.org/model/> .
@prefix cq:   <https://mustrd.org/competencyQuestion/> .
@prefix :     <https://mustrd.org/selfModel/> .

:howDoesASpecSayWhatItExpectsCQ a cq:CompetencyQuestion ;
    cq:question "How does a spec state what it expects, and which variables does it bind?" ;
    cq:cqSpec :howDoesASpecSayWhatItExpects .

:howDoesASpecSayWhatItExpects
    a          must:TestSpec ;
    must:given [ a must:FileDataset ; must:file "a-spec.ttl" ] ;
    must:when  [ a must:TextSparqlSource ;
                 must:queryType must:SelectSparql ;
                 must:queryText """PREFIX must: <https://mustrd.org/model/>
SELECT ?variable ?value WHERE {
  ?spec must:then ?then .
  ?then a must:TableDataset ; must:hasRow ?row .
  ?row must:hasBinding ?binding .
  ?binding must:variable ?variable ; must:boundValue ?value .
}""" ] ;
    must:then  [ a must:TableDataset ;
                 must:hasRow [ must:hasBinding [ must:variable "variable" ;
                                                 must:boundValue "s" ],
                                               [ must:variable "value" ;
                                                 must:boundValue <http://example.org/spec/thing> ] ] ] .
