# What SPARQL does a spec run? Answered by querying a spec file as data.
@prefix must: <https://mustrd.org/model/> .
@prefix cq:   <https://mustrd.org/competencyQuestion/> .
@prefix :     <https://mustrd.org/selfModel/> .

:whatSparqlDoesASpecRunCQ a cq:CompetencyQuestion ;
    cq:question "What SPARQL does a spec run, and of what query type?" ;
    cq:cqSpec :whatSparqlDoesASpecRun .

:whatSparqlDoesASpecRun
    a          must:TestSpec ;
    must:given [ a must:FileDataset ; must:file "a-spec.ttl" ] ;
    must:when  [ a must:TextSparqlSource ;
                 must:queryType must:SelectSparql ;
                 must:queryText """PREFIX must: <https://mustrd.org/model/>
SELECT ?spec ?queryType WHERE {
  ?spec a must:TestSpec ; must:when ?when .
  ?when must:queryType ?queryType .
}""" ] ;
    must:then  [ a must:TableDataset ;
                 must:hasRow
                   [ must:hasBinding [ must:variable "spec" ;
                                       must:boundValue <http://example.org/spec/constructFromStatements> ],
                                     [ must:variable "queryType" ;
                                       must:boundValue must:ConstructSparql ] ] ,
                   [ must:hasBinding [ must:variable "spec" ;
                                       must:boundValue <http://example.org/spec/selectFromAFile> ],
                                     [ must:variable "queryType" ;
                                       must:boundValue must:SelectSparql ] ] ] .
