# Where does a spec get its input, and what kind of dataset is it?
@prefix must: <https://mustrd.org/model/> .
@prefix cq:   <https://mustrd.org/competencyQuestion/> .
@prefix :     <https://mustrd.org/selfModel/> .

:whereDoesASpecGetItsDataCQ a cq:CompetencyQuestion ;
    cq:question "Where does a spec get its input data, and what kind of dataset is it?" ;
    cq:cqSpec :whereDoesASpecGetItsData .

:whereDoesASpecGetItsData
    a          must:TestSpec ;
    must:given [ a must:FileDataset ; must:file "a-spec.ttl" ] ;
    must:when  [ a must:TextSparqlSource ;
                 must:queryType must:SelectSparql ;
                 must:queryText """PREFIX must: <https://mustrd.org/model/>
SELECT ?kind WHERE {
  ?spec a must:TestSpec ; must:given ?given .
  ?given a ?kind .
}""" ] ;
    must:then  [ a must:TableDataset ;
                 must:hasRow [ must:hasBinding [ must:variable "kind" ;
                                                 must:boundValue must:FileDataset ] ] ,
                             [ must:hasBinding [ must:variable "kind" ;
                                                 must:boundValue must:StatementsDataset ] ] ] .
