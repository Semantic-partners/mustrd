@prefix must:      <https://mustrd.org/model/> .
@prefix test-data: <https://semanticpartners.com/data/test/> .

# Two table specs in one file. The file used to be re-parsed once per spec and
# every parse merged into the shared spec graph, so each spec ended up with two
# `then` nodes and both were rejected: "Parsing of multiple components of
# MUST.then for tables not implemented".

test-data:first_of_two_table_specs
    a          must:TestSpec ;
    must:given [ a must:FileDataset ;
                 must:fileurl <file://./../../data/given.ttl> ] ;
    must:when  [ a must:TextSparqlSource ;
                 must:queryText  "SELECT ?s WHERE { ?s ?p ?o }" ;
                 must:queryType must:SelectSparql ; ] ;
    must:then  [ a must:TableDataset ;
                 must:hasRow [ must:hasBinding [ must:variable "s" ;
                                                 must:boundValue test-data:sub ; ] ; ] ; ] .

test-data:second_of_two_table_specs
    a          must:TestSpec ;
    must:given [ a must:FileDataset ;
                 must:fileurl <file://./../../data/given.ttl> ] ;
    must:when  [ a must:TextSparqlSource ;
                 must:queryText  "SELECT ?o WHERE { ?s ?p ?o }" ;
                 must:queryType must:SelectSparql ; ] ;
    must:then  [ a must:TableDataset ;
                 must:hasRow [ must:hasBinding [ must:variable "o" ;
                                                 must:boundValue test-data:obj ; ] ; ] ; ] .
