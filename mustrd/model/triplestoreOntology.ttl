  rdfs:range xsd:string;
  rdfs:comment """A materialised (physically stored) named graph to include in the dataset a query runs over. Repeatable, and combinable with virtualGraph, so the same query can be tested against a chosen mix of materialised and virtual data.""";
  rdfs:label "materialisedGraph" .

:virtualGraph a owl:DatatypeProperty;
  rdfs:domain :Stardog;
  rdfs:range xsd:string;
  rdfs:comment """A virtual (data-virtualisation) named graph to include in the dataset a query runs over. Repeatable, and combinable with materialisedGraph.""";
  rdfs:label "virtualGraph" .

