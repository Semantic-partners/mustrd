@prefix must: <https://mustrd.org/model/> .
@prefix ex:   <http://example.org/> .
@prefix :     <http://example.org/place/example/> .

:mayorOfRotterdam
    a must:TestSpec ;
    must:competencyQuestion "Who is the mayor of Rotterdam?" ;
    must:given [ a must:FileDataset ; must:file "mayor.ttl" ] ;
    must:when  [ a must:TextSparqlSource ;
                 must:queryType must:SelectSparql ;
                 # Bind the city the question asks about, rather than hard-coding
                 # it in the query text.
                 must:hasBinding [ must:variable "city" ; must:boundValue ex:Rotterdam ] ;
                 must:queryText """PREFIX people: <http://example.org/people#>
PREFIX place:  <http://example.org/place#>
SELECT ?mayor WHERE {
  ?mayor a people:Mayor ;
         people:governs ?city .
  ?city a place:City .
}""" ] ;
    must:then  [ a must:TableDataset ;
                 must:hasRow [ must:hasBinding [ must:variable "mayor" ; must:boundValue ex:Aboutaleb ] ] ] .
