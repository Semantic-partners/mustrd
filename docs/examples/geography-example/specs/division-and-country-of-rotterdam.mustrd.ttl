@prefix must: <https://mustrd.org/model/> .
@prefix ex:   <http://example.org/> .
@prefix :     <http://example.org/place/example/> .

:divisionAndCountryOfRotterdamCQ
    a must:CompetencyQuestion ;
    must:question "In what administrative division of what country is Rotterdam?" ;
    must:cqSpec :divisionAndCountryOfRotterdam .

:divisionAndCountryOfRotterdam
    a must:TestSpec ;
    must:given [ a must:FileDataset ; must:file "division.ttl" ] ;
    must:when  [ a must:TextSparqlSource ;
                 must:queryType must:SelectSparql ;
                 must:queryText """PREFIX place: <http://example.org/place#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?division ?country WHERE {
  ?city place:isLocatedIn ?division .
  ?division a/rdfs:subClassOf* place:AdministrativeDivision .
  ?division place:isLocatedIn+ ?country .
  ?country a place:Country .
}""" ] ;
    must:then  [ a must:TableDataset ;
                 must:hasRow [ must:hasBinding [ must:variable "division" ; must:boundValue ex:ZuidHolland ],
                                                [ must:variable "country"  ; must:boundValue ex:NL ] ] ] .
