@prefix geo:  <http://geo.org/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://geo.org/> a owl:Ontology ;
    rdfs:comment "A minimal vocabulary for places and how they are geographically contained within one another." .

geo:Place a owl:Class ;
    rdfs:comment "Anything with a geographic location." .
geo:Continent a owl:Class ; rdfs:subClassOf geo:Place .
geo:Country a owl:Class ; rdfs:subClassOf geo:Place .
geo:AdministrativeDivision a owl:Class ; rdfs:subClassOf geo:Place .
geo:Province a owl:Class ; rdfs:subClassOf geo:AdministrativeDivision .
geo:City a owl:Class ; rdfs:subClassOf geo:Place .
geo:isLocatedIn a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:domain geo:Place ; rdfs:range geo:Place ;
    rdfs:comment "Relates a place to a place that geographically contains it." .
