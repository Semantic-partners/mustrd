@prefix geo:  <http://geo.org/> .
@prefix ex:   <http://example.org/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# The class hierarchy the query's rdfs:subClassOf* path walks. (Only the axioms
# the query needs; the authoritative declarations live in ontology/geography.ttl.)
geo:Province a owl:Class ; rdfs:subClassOf geo:AdministrativeDivision .

ex:Rotterdam   a geo:City     ; geo:isLocatedIn ex:ZuidHolland .
ex:ZuidHolland a geo:Province ; geo:isLocatedIn ex:NL .
ex:NL          a geo:Country  ; geo:isLocatedIn ex:Europe .
ex:Europe      a geo:Continent .
