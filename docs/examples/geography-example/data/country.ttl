@prefix place: <http://example.org/place#> .
@prefix ex:    <http://example.org/> .

ex:Rotterdam a place:City    ; place:isLocatedIn ex:NL .
# place:hasEconomicArea is used here but is not declared in place.ttl — the
# report flags it as "used but not declared".
ex:NL        a place:Country ; place:isLocatedIn ex:Europe ; place:hasEconomicArea ex:EU .
ex:Europe    a place:Continent .
