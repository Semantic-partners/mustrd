@prefix :            <https://mustrd.org/mustrdTest/> .
@prefix triplestore: <https://mustrd.org/triplestore/> .

:geographyCoverageExample
    a :MustrdTest ;
    :hasSpecPath     "specs" ;
    :hasDataPath     "data" ;
    # :hasOntologyPath is repeatable — name each ontology the suite validates.
    # (A directory may also be given; it is scanned recursively.)
    :hasOntologyPath "ontology/geography.ttl" ;
    :hasOntologyPath "ontology/people.ttl" ;
    :hasPytestPath   "rdflib" ;
    :filterOnTripleStore triplestore:RdfLib .
