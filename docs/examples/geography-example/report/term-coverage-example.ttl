<https://mustrd.org/coverage/run/local/issue/tbox-in-data/divisionAndCountryOfRotterdam> a cov:QualityIssue ;
    prov:wasGeneratedBy <https://mustrd.org/coverage/run/local> ;
    cov:aboutTest <http://example.org/place/example/divisionAndCountryOfRotterdam> ;
    cov:detail "place:Province a owl:Class",
        "place:Province rdfs:subClassOf place:AdministrativeDivision" ;
    cov:issueType cov:TBoxInTestData .

