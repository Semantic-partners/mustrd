<http://example.org/governance#> a owl:Ontology ;
    rdfs:comment "A tiny vocabulary for governance roles and the places they govern." ;
    owl:versionIRI <http://example.org/governance/1.0.0> .

<http://example.org/place#> a owl:Ontology ;
    rdfs:comment "A minimal vocabulary for places and how they are geographically contained within one another." ;
    owl:versionIRI <http://example.org/place/1.0.0> .

